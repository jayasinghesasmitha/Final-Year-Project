`timescale 1ns/1ps

module mnv2_depthwise_top #(
    parameter integer H       = 4,
    parameter integer W       = 4,
    parameter integer CIN     = 8,
    parameter integer CEXP    = 24,
    parameter integer COUT    = 16,
    parameter integer DATA_W  = 8,
    parameter integer ACC_W   = 32
)(
    input wire clk,
    input wire rst,
    input wire start,

    output reg busy,
    output reg done,

    input wire ifmap_wr_en,
    input wire [6:0] ifmap_wr_addr,
    input wire signed [DATA_W-1:0] ifmap_wr_data,

    input wire exp_wr_en,
    input wire [7:0] exp_wr_addr,
    input wire signed [DATA_W-1:0] exp_wr_data,

    input wire dw_wr_en,
    input wire [7:0] dw_wr_addr,
    input wire signed [DATA_W-1:0] dw_wr_data,

    input wire proj_wr_en,
    input wire [8:0] proj_wr_addr,
    input wire signed [DATA_W-1:0] proj_wr_data,

    input wire [7:0] out_rd_addr,
    output reg signed [ACC_W-1:0] out_rd_data
);

    // ============================================================
    // MEMORY SIZES
    // ============================================================

    localparam integer IFMAP_N = H * W * CIN;
    localparam integer EXP_W_N = CEXP * CIN;
    localparam integer DW_W_N = CEXP * 9;
    localparam integer PROJ_W_N = COUT * CEXP;

    localparam integer SPATIAL_COUNT = H * W;

    localparam integer EXP_N = H * W * CEXP;
    localparam integer DW_N = H * W * CEXP;
    localparam integer OUT_N = H * W * COUT;


    // ============================================================
    // MEMORIES
    // ============================================================

    reg signed [DATA_W-1:0] ifmap_mem [0:IFMAP_N-1];
    reg signed [DATA_W-1:0] exp_w_mem [0:EXP_W_N-1];
    reg signed [DATA_W-1:0] dw_w_mem [0:DW_W_N-1];
    reg signed [DATA_W-1:0] proj_w_mem [0:PROJ_W_N-1];

    reg signed [ACC_W-1:0] expanded_mem [0:EXP_N-1];
    reg signed [ACC_W-1:0] dw_mem [0:DW_N-1];
    reg signed [ACC_W-1:0] output_mem [0:OUT_N-1];


    // ============================================================
    // FSM
    // ============================================================

    localparam [2:0]
        S_IDLE = 3'd0,
        S_EXP  = 3'd1,
        S_DW   = 3'd2,
        S_PROJ = 3'd3,
        S_DONE = 3'd4;

    reg [2:0] state;


    // ============================================================
    // EXPANSION
    // ============================================================

    integer spatial_idx;
    integer exp_ch;
    integer cin_cnt;

    reg signed [ACC_W-1:0] exp_acc_reg;


    // ============================================================
    // DEPTHWISE
    // ============================================================

    integer dw_ch;
    integer dw_tap;

    reg signed [ACC_W-1:0] dw_acc_reg;


    // ============================================================
    // PROJECTION
    // ============================================================

    integer out_ch;
    integer proj_ch;

    reg signed [ACC_W-1:0] proj_acc_reg;


    // ============================================================
    // TEMPORARY INDEX VARIABLES
    // ============================================================

    integer if_idx;
    integer exp_idx;
    integer dw_idx;
    integer proj_idx;
    integer out_idx;

    integer current_row;
    integer current_col;

    integer kernel_row;
    integer kernel_col;

    integer neighbor_row;
    integer neighbor_col;

    integer neighbor_spatial;
    integer neighbor_idx;

    integer product;

    integer i;


    // ============================================================
    // OUTPUT READ
    // ============================================================

    always @(*) begin

        if (out_rd_addr < OUT_N)
            out_rd_data = output_mem[out_rd_addr];
        else
            out_rd_data = 0;

    end


    // ============================================================
    // MAIN SEQUENTIAL PROCESS
    // ============================================================

    always @(posedge clk) begin

        // ========================================================
        // RESET
        // ========================================================

        if (rst) begin

            busy <= 1'b0;
            done <= 1'b0;

            state <= S_IDLE;

            spatial_idx <= 0;

            exp_ch <= 0;
            cin_cnt <= 0;

            dw_ch <= 0;
            dw_tap <= 0;

            out_ch <= 0;
            proj_ch <= 0;

            exp_acc_reg <= 0;
            dw_acc_reg <= 0;
            proj_acc_reg <= 0;

            for (i = 0; i < EXP_N; i = i + 1)
                expanded_mem[i] = 0;

            for (i = 0; i < DW_N; i = i + 1)
                dw_mem[i] = 0;

            for (i = 0; i < OUT_N; i = i + 1)
                output_mem[i] = 0;

        end

        // ========================================================
        // NORMAL OPERATION
        // ========================================================

        else begin

            // ====================================================
            // HOST MEMORY LOADS
            // ====================================================

            if (!busy && state == S_IDLE) begin

                if (ifmap_wr_en &&
                    ifmap_wr_addr < IFMAP_N) begin

                    ifmap_mem[ifmap_wr_addr] <=
                        ifmap_wr_data;

                end

                if (exp_wr_en &&
                    exp_wr_addr < EXP_W_N) begin

                    exp_w_mem[exp_wr_addr] <=
                        exp_wr_data;

                end

                if (dw_wr_en &&
                    dw_wr_addr < DW_W_N) begin

                    dw_w_mem[dw_wr_addr] <=
                        dw_wr_data;

                end

                if (proj_wr_en &&
                    proj_wr_addr < PROJ_W_N) begin

                    proj_w_mem[proj_wr_addr] <=
                        proj_wr_data;

                end

            end


            // ====================================================
            // FSM
            // ====================================================

            case (state)

                // =================================================
                // IDLE
                // =================================================

                S_IDLE: begin

                    busy <= 1'b0;

                    if (start) begin

                        busy <= 1'b1;
                        done <= 1'b0;

                        spatial_idx <= 0;

                        exp_ch <= 0;
                        cin_cnt <= 0;
                        exp_acc_reg <= 0;

                        dw_ch <= 0;
                        dw_tap <= 0;
                        dw_acc_reg <= 0;

                        out_ch <= 0;
                        proj_ch <= 0;
                        proj_acc_reg <= 0;

                        state <= S_EXP;

                    end

                end


                // =================================================
                // EXPANSION
                // =================================================

                S_EXP: begin

                    busy <= 1'b1;

                    /*
                     * IFMAP address:
                     *
                     * spatial * CIN + input_channel
                     */

                    if_idx =
                        spatial_idx * CIN +
                        cin_cnt;


                    /*
                     * Expanded feature address:
                     *
                     * spatial * CEXP + expansion_channel
                     */

                    exp_idx =
                        spatial_idx * CEXP +
                        exp_ch;


                    /*
                     * 1x1 convolution.
                     */

                    product =
                        $signed(ifmap_mem[if_idx]) *
                        $signed(
                            exp_w_mem[
                                exp_ch * CIN +
                                cin_cnt
                            ]
                        );


                    /*
                     * Last input channel.
                     */

                    if (cin_cnt == CIN - 1) begin

                        expanded_mem[exp_idx] <=
                            exp_acc_reg + product;

                        exp_acc_reg <= 0;

                        cin_cnt <= 0;


                        /*
                         * Last expansion channel.
                         */

                        if (exp_ch == CEXP - 1) begin

                            exp_ch <= 0;

                            dw_ch <= 0;
                            dw_tap <= 0;
                            dw_acc_reg <= 0;

                            state <= S_DW;

                        end

                        else begin

                            exp_ch <=
                                exp_ch + 1;

                        end

                    end

                    else begin

                        exp_acc_reg <=
                            exp_acc_reg + product;

                        cin_cnt <=
                            cin_cnt + 1;

                    end

                end


                // =================================================
                // DEPTHWISE
                // =================================================
                //
                // One 3x3 tap per clock.
                //
                // tap:
                //
                //       0 1 2
                //       3 4 5
                //       6 7 8
                //
                // corresponding to:
                //
                //      (-1,-1) (-1,0) (-1,+1)
                //      ( 0,-1) ( 0,0) ( 0,+1)
                //      (+1,-1) (+1,0) (+1,+1)
                //
                // Out-of-range coordinates contribute ZERO.
                //
                // =================================================

                S_DW: begin

                    busy <= 1'b1;


                    // ------------------------------------------------
                    // Current spatial position
                    // ------------------------------------------------

                    current_row =
                        spatial_idx / W;

                    current_col =
                        spatial_idx % W;


                    // ------------------------------------------------
                    // Convert tap number to kernel coordinates
                    // ------------------------------------------------

                    kernel_row =
                        dw_tap / 3;

                    kernel_col =
                        dw_tap % 3;


                    // ------------------------------------------------
                    // Calculate neighbor coordinate
                    // ------------------------------------------------

                    neighbor_row =
                        current_row +
                        kernel_row -
                        1;

                    neighbor_col =
                        current_col +
                        kernel_col -
                        1;


                    // ------------------------------------------------
                    // Default: zero padding
                    // ------------------------------------------------

                    product = 0;


                    // ------------------------------------------------
                    // Valid coordinate
                    // ------------------------------------------------

                    if ((neighbor_row >= 0) &&
                        (neighbor_row < H) &&
                        (neighbor_col >= 0) &&
                        (neighbor_col < W)) begin

                        neighbor_spatial =
                            neighbor_row * W +
                            neighbor_col;

                        neighbor_idx =
                            neighbor_spatial * CEXP +
                            dw_ch;

                        product =
                            $signed(
                                expanded_mem[neighbor_idx]
                            ) *
                            $signed(
                                dw_w_mem[
                                    dw_ch * 9 +
                                    dw_tap
                                ]
                            );

                    end


                    // ------------------------------------------------
                    // LAST TAP
                    // ------------------------------------------------

                    if (dw_tap == 8) begin

                        /*
                         * Store complete depthwise result.
                         *
                         * IMPORTANT:
                         * Include the current product here.
                         */

                        dw_idx =
                            spatial_idx * CEXP +
                            dw_ch;

                        dw_mem[dw_idx] <=
                            dw_acc_reg + product;


                        /*
                         * Reset depthwise accumulator.
                         */

                        dw_acc_reg <= 0;
                        dw_tap <= 0;


                        /*
                         * Last expansion channel?
                         */

                        if (dw_ch == CEXP - 1) begin

                            dw_ch <= 0;

                            out_ch <= 0;
                            proj_ch <= 0;
                            proj_acc_reg <= 0;

                            state <= S_PROJ;

                        end

                        else begin

                            dw_ch <=
                                dw_ch + 1;

                        end

                    end

                    else begin

                        /*
                         * Accumulate current tap.
                         */

                        dw_acc_reg <=
                            dw_acc_reg + product;

                        dw_tap <=
                            dw_tap + 1;

                    end

                end


                // =================================================
                // PROJECTION
                // =================================================

                S_PROJ: begin

                    busy <= 1'b1;


                    /*
                     * Depthwise input.
                     */

                    dw_idx =
                        spatial_idx * CEXP +
                        proj_ch;


                    /*
                     * Projection weight.
                     */

                    proj_idx =
                        out_ch * CEXP +
                        proj_ch;


                    /*
                     * Output address.
                     */

                    out_idx =
                        spatial_idx * COUT +
                        out_ch;


                    /*
                     * Projection MAC.
                     */

                    product =
                        $signed(dw_mem[dw_idx]) *
                        $signed(proj_w_mem[proj_idx]);


                    /*
                     * Last projection channel.
                     */

                    if (proj_ch == CEXP - 1) begin

                        /*
                         * Include final product.
                         */

                        output_mem[out_idx] <=
                            proj_acc_reg + product;

                        proj_acc_reg <= 0;
                        proj_ch <= 0;


                        /*
                         * Last output channel.
                         */

                        if (out_ch == COUT - 1) begin

                            out_ch <= 0;


                            /*
                             * Last spatial position.
                             */

                            if (spatial_idx ==
                                SPATIAL_COUNT - 1) begin

                                busy <= 1'b0;
                                done <= 1'b1;

                                state <= S_DONE;

                            end

                            else begin

                                /*
                                 * Next spatial position.
                                 */

                                spatial_idx <=
                                    spatial_idx + 1;

                                /*
                                 * Restart expansion.
                                 */

                                exp_ch <= 0;
                                cin_cnt <= 0;
                                exp_acc_reg <= 0;

                                /*
                                 * Restart depthwise.
                                 */

                                dw_ch <= 0;
                                dw_tap <= 0;
                                dw_acc_reg <= 0;

                                /*
                                 * Restart projection.
                                 */

                                out_ch <= 0;
                                proj_ch <= 0;
                                proj_acc_reg <= 0;

                                state <= S_EXP;

                            end

                        end

                        else begin

                            out_ch <=
                                out_ch + 1;

                        end

                    end

                    else begin

                        proj_acc_reg <=
                            proj_acc_reg + product;

                        proj_ch <=
                            proj_ch + 1;

                    end

                end


                // =================================================
                // DONE
                // =================================================

                S_DONE: begin

                    busy <= 1'b0;
                    done <= 1'b1;

                    /*
                     * Allow a new START after completion.
                     */

                    if (start) begin

                        busy <= 1'b1;
                        done <= 1'b0;

                        spatial_idx <= 0;

                        exp_ch <= 0;
                        cin_cnt <= 0;
                        exp_acc_reg <= 0;

                        dw_ch <= 0;
                        dw_tap <= 0;
                        dw_acc_reg <= 0;

                        out_ch <= 0;
                        proj_ch <= 0;
                        proj_acc_reg <= 0;

                        state <= S_EXP;

                    end

                end


                // =================================================
                // DEFAULT
                // =================================================

                default: begin

                    busy <= 1'b0;
                    done <= 1'b0;

                    state <= S_IDLE;

                end

            endcase

        end

    end

endmodule
